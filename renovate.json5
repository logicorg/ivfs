{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "ci/images.go"
            ],
            "matchStrings": [
                "\\w+\\s*=\\s*\"(?<depName>[\\w./-]+)[:@](?<currentValue>.*?)\""
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],
    "extends": [
        ":semanticCommits"
    ],
    "gomod": {
        "ignorePaths": [
            "ci/**"
        ],
        "postUpdateOptions": [
            "gomodTidy"
        ]
    }
}